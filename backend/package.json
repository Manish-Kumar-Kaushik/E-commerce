{
  "name": "backend",
  "version": "1.0.0",
  "description": "Production-ready e-commerce backend with Express and MongoDB",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node src/utils/seedData.js",
    "seed:clear": "node src/utils/seedData.js --clear",
    "mongo:clear:keep-collections": "node src/utils/clearMongoDataKeepCollections.js",
    "mongo:clear:keep-admin": "node src/utils/clearMongoDataKeepAdmin.js",
    "admin:ensure": "node src/utils/ensureDefaultAdmin.js",
    "vendor:ensure": "node src/utils/ensureDefaultVendor.js",
    "smoke": "node src/utils/smokeTest.js",
    "test": "node --test",
    "index:review": "node src/utils/reviewIndexes.js"
  },
  "keywords": [
    "node",
    "express",
    "mongodb",
    "ecommerce",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/clerk-sdk-node": "^4.13.23",
    "@google/generative-ai": "^0.24.1",
    "@sendgrid/mail": "^8.1.6",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.5",
    "pdfkit": "^0.18.0",
    "stripe": "^21.0.1",
    "swagger-ui-dist": "^5.32.4"
  }
}
